# ─────────────────────────────────────────────────────────────────────────────
# SportLynk backend — environment template
#
#   cp .env.example .env      then fill in the real values
#
# .env is gitignored and MUST stay that way — it holds the database password and
# the token signing secret. This file is the committed contract: every variable
# the backend reads is listed below, so a fresh clone knows exactly what to set.
#
# Marked [required] must be present or the API will not work.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
# [required] Supabase is the only database, in development and for the demo.
# Use the SESSION POOLER URI from Supabase → Project Settings → Database, and
# keep sslmode=require. The pooler (port 5432 on ...pooler.supabase.com) is what
# survives a laptop's changing network; the direct db.<ref>.supabase.co host does
# not always resolve on IPv4-only connections.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ─── Auth ────────────────────────────────────────────────────────────────────
# [required] Signs and verifies every JWT. Any long random string; changing it
# invalidates all existing logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<48-plus-random-bytes-hex>

# ─── Server ──────────────────────────────────────────────────────────────────
# Port the API listens on. Defaults to 3000, which is what the Flutter app
# expects via adb reverse tcp:3000 tcp:3000.
#
# On Render, do NOT set this — Render injects its own PORT and the server reads
# it. Hard-coding 3000 there makes the health check fail.
PORT=3000

# development | production. Affects logging verbosity and forces TLS on the
# database connection. TLS is now also derived from sslmode= in DATABASE_URL and
# from the host not being localhost (src/db/pool.js), so a forgotten NODE_ENV no
# longer breaks the connection. Leave as development locally — morgan's 'dev' log
# format and the verbose error logging are both tuned for a terminal you are
# watching. Set production on Render.
NODE_ENV=development

# ─── Test-timing overrides (LOCAL DEMOS ONLY — never set on Render) ───────────
# The SRS timings are hours long, which makes three features impossible to
# demonstrate live: you cannot wait 2 hours for a pending booking to
# auto-approve while a supervisor watches. These four variables shrink those
# clocks. Leave every one of them UNSET and the code uses the SRS defaults
# byte-for-byte — they are read from the environment and nowhere else.
#
# When any is set, the server prints a loud multi-line banner at boot so the
# shortened timings can never be mistaken for real behaviour.
#
# Usage (PowerShell, one demo at a time):
#   $env:SL_TEST_AUTO_DECIDE_MINUTES=1; $env:SL_TEST_SWEEP_SECONDS=15; node src/server.js
#
# Overrides AUTO_DECIDE_AFTER_MINUTES (default 120 = 2h) — pending → confirmed.
# SL_TEST_AUTO_DECIDE_MINUTES=1
#
# Overrides NO_SHOW_GRACE_MINUTES (default 30) — after which a no-show penalty
# is applied to a confirmed booking nobody checked into.
# SL_TEST_NO_SHOW_MINUTES=1
#
# Overrides WITHDRAWAL_SETTLE_MINUTES (default 1440 = 24h) — pending → completed.
# SL_TEST_SETTLE_MINUTES=1
#
# Overrides SWEEP_INTERVAL_MS for all three background jobs (default 300000 =
# 5 min). The jobs only act when they run, so shortening a deadline above
# without also shortening this means waiting up to 5 minutes for the next sweep.
# SL_TEST_SWEEP_SECONDS=15

# ─── ML service (S.3 onward) ─────────────────────────────────────────────────
# Base URL of the Python FastAPI service that serves the trained scikit-learn
# models (ml-service/ in this repo). Model #1 is dynamic pricing + demand
# forecasting; sentiment, trust and the recommender follow in later milestones.
#
# OPTIONAL, by design. src/services/mlClient.js degrades to a heuristic when the
# service is unreachable, unset, or has no model trained yet, and every response
# carries source:'model' | 'heuristic' so the dashboard can say which it is. The
# API runs perfectly well with these two lines commented out — you just get
# heuristic prices and no demand forecast.
#
# Local default below. Point it at the deployed service for the demo (S.7 adds
# ml-service as a second Render service). No trailing slash needed; one is
# tolerated.
ML_SERVICE_URL=http://127.0.0.1:8000

# Shared secret the backend sends as the X-API-Key header. ml-service refuses to
# start without it and rejects every request that does not carry it.
#
# MUST BE BYTE-IDENTICAL to ML_API_KEY in ml-service/.env — no trailing space, no
# quotes, no stray newline. If the two differ, every call gets a 401 and the
# dashboard silently serves heuristic prices, which looks exactly like the model
# not being trained yet. That is an hour of debugging you can skip:
#
#   generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   verify:    node src/scripts/check_ml_service.js
#              -> compares the sha256 fingerprint of both files' keys and tells you
#                 if they differ, without printing either secret
ML_API_KEY=<shared-secret-between-backend-and-ml-service>

# Optional. Request timeout in ms for every ml-service call; default 2000, which
# is the ceiling the owner dashboard is designed around. Clamped to 100–10000 —
# a typo'd 200000 would hold a dashboard request open for 200 seconds, which is
# worse than any degradation this client exists to avoid.
# ML_TIMEOUT_MS=2000

# ─── Firebase (placeholders — server-side verification not wired up yet) ─────
# Phone OTP currently runs entirely in the Flutter client (Firebase Auth); the
# backend accepts the resulting firebaseUid without re-verifying it. To verify
# server-side later, these are the Admin SDK service-account fields, taken from
# the JSON key at Firebase Console → Project Settings → Service accounts.
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@<firebase-project-id>.iam.gserviceaccount.com
# Keep the literal \n escapes and the surrounding quotes — the key is multi-line.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<key-body>\n-----END PRIVATE KEY-----\n"

# ─── Legacy local-Postgres vars (not needed) ─────────────────────────────────
# Only run_migration_009.js still reads these, and it falls back to local
# defaults. Everything else — including src/scripts/seed_venues.js, which was
# rewired in Wave E — goes through DATABASE_URL. Listed for completeness; leave
# them unset.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sportlynk
# DB_USER=postgres
# DB_PASSWORD=<local-postgres-password>
