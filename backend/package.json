    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "firebase-admin": "14.3.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "pg": "^8.20.0",
    "socket.io": "^4.8.3"
